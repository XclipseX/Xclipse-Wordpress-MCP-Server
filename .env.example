# Copy this file to .env and fill in your own values

# WordPress site root URL (no trailing slash)
XCLIPSE_URL=https://your-site.example

# API key from wp-admin → Settings → Xclipse MCP Lite
XCLIPSE_API_KEY=your-api-key-here

# Compact JSON responses (drop null, "", []) to save tokens (1 = on, 0 = off)
XCLIPSE_COMPACT=1

# ── Remote MCP server (optional HTTP mode) ──
# Set PORT or MCP_TRANSPORT=http to serve over Streamable HTTP instead of stdio
# PORT=3000
# MCP_AUTH_TOKEN=your-secret-bearer-token
